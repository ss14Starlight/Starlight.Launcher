# Text is stored and checked out with LF everywhere, regardless of core.autocrlf.
* text=auto eol=lf

# Windows-only scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.iss text eol=crlf

# Binaries
*.dll binary
*.exe binary
*.ico binary
*.nupkg binary
*.png binary
*.ttf binary
*.woff binary
*.woff2 binary
