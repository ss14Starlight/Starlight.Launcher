@using Robust.Launcher.Api.Models
@using Starlight.Launcher.WebUI.Models.Auth;
@using Starlight.Launcher.WebUI.Localization;

@inherits LocalizedComponentBase

<MudText Typo="Typo.h5" Class="mb-4"> @L["auth-menu-accounts-mode"] </MudText>

@if (_bridge.GetLoginEntries().Count == 0)
{
    <MudStack AlignItems="AlignItems.Center" Class="empty-state py-8">
        <MudIcon Icon="@Icons.Material.Outlined.PersonOff"
                    Class="empty-icon mb-2" />
        <MudText Typo="Typo.body1">@L["auth-menu-no-accounts"]</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">
            @L["auth-menu-no-accounts-hint"]
        </MudText>
    </MudStack>
}
else
{
    <div class="account-list">
        @foreach (var account in _bridge.GetLoginEntries())
        {
            var acc = account;
            var isActive = _bridge.GetActiveAccountId() == acc.UserId;
            var isViewed = ViewedUserId == acc.UserId;

            <div @key="acc.UserId"
                 class="@($"account-row {(isActive ? "account-row-active" : "")} {(isViewed ? "account-row-viewed" : "")}")"
                 role="button" tabindex="0"
                 @onclick="() => OnView?.Invoke(acc)">

                <MudAvatar Class="account-avatar" Color="Color.Primary" Size="Size.Medium">
                    @(string.IsNullOrEmpty(acc.LoginInfo.Username)
                        ? "?"
                        : char.ToUpperInvariant(acc.LoginInfo.Username[0]).ToString())
                </MudAvatar>

                <div class="account-info">
                    <div class="account-name-row">
                        <span class="account-name">@acc.LoginInfo.Username</span>
                        @if (acc.LoginInfo.Token != null)
                        {
                            <MudTooltip Text="@L["auth-menu-can-play-no-discord"]">
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                         Size="Size.Small" Color="Color.Success" />
                            </MudTooltip>
                        }
                        else
                        {
                            <MudTooltip Text="@L["auth-menu-needs-discord"]">
                                <MudIcon Icon="@Icons.Material.Filled.Cancel"
                                         Size="Size.Small" Color="Color.Error" />
                            </MudTooltip>
                        }
                        @if (acc.LoginInfo.DiscordToken != null)
                        {
                            <MudTooltip Text="@L["auth-menu-discord-linked-tooltip"]">
                                <MudIcon Icon="@Icons.Custom.Brands.Discord" Size="Size.Small" Color="Color.Info" />
                            </MudTooltip>
                        }
                        @if (acc.LoginInfo.SteamToken != null)
                        {
                            <MudTooltip Text="@L["auth-menu-steam-linked-tooltip"]">
                                <MudIcon Icon="@Icons.Custom.Brands.Steam" Size="Size.Small" Color="Color.Info" />
                            </MudTooltip>
                        }
                    </div>

                    <div class="account-status">
                        <span class="status-dot"
                              style="background:var(--mud-palette-@(StatusCssVar(acc)));
                                     box-shadow:0 0 8px 1px var(--mud-palette-@(StatusCssVar(acc)))"></span>
                        <span class="mud-text-secondary">@(isActive ? L["auth-menu-active-chip"] : StatusLabel(acc))</span>
                    </div>
                </div>

                <div class="account-actions" @onclick:stopPropagation="true">
                    @if (acc.Status == AccountLoginStatus.Expired)
                    {
                        <MudTooltip Text="@L["auth-menu-login-again-button"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" Color="Color.Warning"
                                           Disabled="Busy"
                                           OnClick="() => OnAccountRelogin?.Invoke(acc)" />
                        </MudTooltip>
                    }
                    else
                    {
                        <MudTooltip Text="@(isActive ? L["auth-menu-active-chip"] : L["auth-menu-select-button"])">
                            <MudIconButton Icon="@(isActive ? Icons.Material.Filled.RadioButtonChecked : Icons.Material.Filled.RadioButtonUnchecked)"
                                           Size="Size.Small"
                                           Color="@(isActive ? Color.Primary : Color.Default)"
                                           Disabled="@(isActive || Busy)"
                                           OnClick="() => Select(acc)" />
                        </MudTooltip>
                    }

                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Class="row-menu-btn"
                             Dense="true" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                             Disabled="Busy">
                        @if (CanLinkDiscord(acc))
                        {
                            <MudMenuItem Icon="@Icons.Custom.Brands.Discord" IconColor="Color.Info"
                                         OnClick="() => OnDiscordLink?.Invoke(acc)">
                                @L["auth-menu-link-discord-button"]
                            </MudMenuItem>
                        }
                        @if (CanLinkSteam(acc))
                        {
                            <MudMenuItem Icon="@Icons.Custom.Brands.Steam" IconColor="Color.Info"
                                         OnClick="() => OnSteamLink?.Invoke(acc)">
                                @L["auth-menu-link-steam-button"]
                            </MudMenuItem>
                        }
                        @if (acc.Status != AccountLoginStatus.Expired && acc.LoginInfo.Token == null && acc.LoginInfo.DiscordToken != null)
                        {
                            <MudMenuItem Icon="@Icons.Material.Filled.Key" IconColor="Color.Info"
                                         OnClick="() => OnLink?.Invoke(acc)">
                                @L["auth-menu-link-account-button"]
                            </MudMenuItem>
                        }
                        <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error"
                                     OnClick="() => RemoveAccount(acc)">
                            @L["auth-menu-delete-account-button"]
                        </MudMenuItem>
                    </MudMenu>
                </div>
            </div>
        }
    </div>
}

<MudButton Variant = "Variant.Filled"
    Color = "Color.Primary"
    FullWidth = "true"
    StartIcon = "@Icons.Material.Filled.Add"
    Class="mt-4 cta-btn-primary"
    OnClick = "() => OnSignIn?.Invoke()" >
    @L["auth-menu-add-account-button"]
</MudButton>
