@using Starlight.Launcher.WebUI.Components.Pages
@using Starlight.Launcher.WebUI.Localization;

@inherits LocalizedComponentBase

<MudStack Row = "true" AlignItems = "AlignItems.Center" Class = "mb-4">
    <MudIconButton Icon = "@Icons.Material.Filled.ArrowBack" Class="icon-btn-ghost"
        OnClick = "() => OnModeSwitch?.Invoke(Mode.SignIn)"
        Disabled = "Busy" />
    <MudText Typo="Typo.h5">@L["auth-menu-forgotpassword"]</MudText>
</MudStack>

@if (Success)
{
    <MudAlert Severity = "Severity.Success" Class="mb-3 success-alert">
        @L["auth-menu-forgotpassword-alert"]
    </MudAlert>
    <MudButton Variant = "Variant.Filled"
        Color = "Color.Primary"
        FullWidth = "true"
        Class="cta-btn-primary"
        OnClick = "() => OnModeSwitch?.Invoke(Mode.SignIn)">
        @L["auth-menu-signin"]
    </MudButton>
    return;
}

<MudText Class="mb-3">@L["auth-menu-enter-email-label"]</MudText>

<MudTextField @bind-Value = "Email"
    Label="@L["auth-menu-email-label"]"
    InputType = "InputType.Email"
    Variant = "Variant.Outlined"
    Disabled = "Busy"
    Class="mb-3 auth-field"/>

@if (!string.IsNullOrEmpty(Error))
{
    <MudAlert Severity = "Severity.Error" Class="mb-3 error-alert"> @Error </MudAlert>
}

<MudButton Variant = "Variant.Filled"
    Color = "Color.Primary"
    FullWidth = "true"
    Disabled = "Busy"
    OnClick = "DoForgotPassword"
    Class="cta-btn-primary">
    @if (Busy)
    {
        <MudProgressCircular Size = "Size.Small" Indeterminate = "true" Class = "mr-2"/>
        <span>@L["auth-menu-forgotpassword-status-busy"]</span>
    }
    else
    {
        <span>@L["auth-menu-forgotpassword-status-wait"]</span>
    }
</MudButton>
