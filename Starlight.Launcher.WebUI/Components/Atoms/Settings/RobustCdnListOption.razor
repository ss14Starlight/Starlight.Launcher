@using Starlight.Launcher.WebUI.Localization
@using Starlight.Launcher.WebUI.Models.Settings
@inherits LocalizedComponentBase

<MudPaper Class="sl-option-card pa-4 mb-2" Outlined="true" Elevation="0">
    <div class="d-flex align-center mb-2">
        <div class="sl-option-icon mr-4">
            <MudIcon Icon="@Icon" Size="Size.Small" />
        </div>
        <div class="flex-grow-1">
            <MudText Typo="Typo.body1">@Title</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@Description</MudText>
        </div>
        <MudTooltip Text="@AddButtonTooltip">
            <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" OnClick="AddCdn" />
        </MudTooltip>
    </div>

    @if (Value.Count == 0)
    {
        <MudPaper Class="pa-4 d-flex align-center justify-center" Outlined="true" Elevation="0"
                  Style="border-style: dashed;">
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@EmptyValuesString</MudText>
        </MudPaper>
    }
    else
    {
        <MudStack Spacing="2">
            @for (var i = 0; i < Value.Count; i++)
            {
                var index = i;
                var cdn = Value[index];

                <MudPaper Outlined="true" Elevation="0" Class="pa-3">
                    <div class="d-flex align-center gap-2 mb-2">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                 Color="@(index == 0 ? Color.Primary : Color.Default)">
                            @(index + 1)
                        </MudChip>

                        <MudTextField T="string"
                                      Value="@cdn.Name"
                                      ValueChanged="@(v => UpdateCdn(index, c => c with { Name = v }))"
                                      Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Label="@L["settings-cdns-option-name-label"]"
                                      Class="flex-grow-1" />

                        @if (cdn.Important)
                        {
                            <MudTooltip Text="@L["settings-cdns-option-important-tooltip"]">
                                <MudIcon Icon="@Icons.Material.Filled.Shield" Size="Size.Small" Color="Color.Warning" />
                            </MudTooltip>
                        }

                        <MudTooltip Text="@L["settings-cdns-option-enabled-tooltip"]">
                            <MudSwitch T="bool"
                                       Value="@cdn.Enabled"
                                       ValueChanged="@(v => ToggleEnabled(index, v))"
                                       Color="Color.Primary" />
                        </MudTooltip>

                        <MudTooltip Text="@L["settings-alternative-list-option-move-up"]">
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small"
                                           Disabled="@(index == 0)" OnClick="@(() => MoveUp(index))" />
                        </MudTooltip>
                        <MudTooltip Text="@L["settings-alternative-list-option-move-down"]">
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small"
                                           Disabled="@(index == Value.Count - 1)" OnClick="@(() => MoveDown(index))" />
                        </MudTooltip>
                        <MudTooltip Text="@L["settings-alternative-list-option-remove"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                           Color="Color.Error" OnClick="@(() => RemoveAt(index))" />
                        </MudTooltip>
                    </div>

                    <MudTextField T="string"
                                  Value="@cdn.PublicKey"
                                  ValueChanged="@(v => UpdateCdn(index, c => c with { PublicKey = v }))"
                                  Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Lines="3" Label="@L["settings-cdns-option-key-label"]"
                                  Disabled="@(!AllowKeyEditing)"
                                  Validation="@(new Func<string, string?>(ValidateKey))"
                                  Class="mb-2" />

                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["settings-cdns-option-mirrors-label"]</MudText>
                    <MudStack Spacing="1" Class="mt-1">
                        @for (var j = 0; j < cdn.Urls.Count; j++)
                        {
                            var urlIndex = j;
                            <div class="d-flex align-center gap-2">
                                <MudTextField T="string"
                                              Value="@cdn.Urls[urlIndex]"
                                              ValueChanged="@(v => UpdateUrl(index, urlIndex, v))"
                                              Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                              Placeholder="https://example.com/"
                                              Validation="@(new Func<string, string?>(ValidateUrl))"
                                              Class="flex-grow-1" />
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                               Disabled="@(cdn.Urls.Count <= 1)"
                                               OnClick="@(() => RemoveUrl(index, urlIndex))" />
                            </div>
                        }
                        <MudButton StartIcon="@Icons.Material.Filled.Add" Size="Size.Small"
                                   Variant="Variant.Text" OnClick="@(() => AddUrl(index))">
                            @L["settings-cdns-option-add-mirror"]
                        </MudButton>
                    </MudStack>
                </MudPaper>
            }
        </MudStack>
    }
</MudPaper>
