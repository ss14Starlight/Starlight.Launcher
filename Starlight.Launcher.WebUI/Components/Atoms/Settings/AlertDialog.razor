@using Starlight.Launcher.WebUI.Localization;

@inherits LocalizedComponentBase

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1">
            @L["settings-development-tab-alert-description"]
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Secondary">@L["general-cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Class="cta-btn-primary" OnClick="Success">@L["general-ok"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    public event Action? OnCancel;
    public event Action? OnSuccess;

    private void Success()
    {
        OnSuccess?.Invoke();
        MudDialog.Close();
    }

    private void Cancel()
    {
        OnCancel?.Invoke();
        MudDialog.Cancel();
    }
}
