@using Starlight.Launcher.WebUI.Localization;
@using Starlight.Launcher.WebUI.Models.DiscordRichPresence;

@inherits LocalizedComponentBase

<MudPaper Class="sl-option-card pa-4 mb-2" Outlined="true" Elevation="0">
    <div class="d-flex align-center mb-3">
        <div class="sl-option-icon mr-4">
            <MudIcon Icon="@Icon" Size="Size.Small" />
        </div>
        <div class="flex-grow-1">
            <MudText Typo="Typo.body1">@Title</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                @Description
            </MudText>
        </div>
        <MudTooltip Text="@ResetButtonTooltip">
            <MudIconButton Icon="@Icons.Material.Filled.RestartAlt"
                           Color="Color.Default"
                           OnClick="ResetToDefault" />
        </MudTooltip>
    </div>

    <MudStack Spacing="2">
        @for (var i = 0; i < Value.Count; i++)
        {
            var index = i;
            var option = Value[index];
            var movable = PresenceStates.IsMovable(option.State);

            <div class="d-flex align-center gap-2">
                <MudTooltip Text="@(movable ? PriorityTooltip : PinnedTooltip)">
                    <MudChip T="string"
                             Size="Size.Small"
                             Color="@(option.Enabled ? Color.Primary : Color.Default)"
                             Variant="Variant.Filled">
                        @if (movable)
                        {
                            @(index + 1)
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" />
                        }
                    </MudChip>
                </MudTooltip>

                <div class="flex-grow-1">
                    <MudText Typo="Typo.body2"
                             Class="@(option.Enabled ? null : "mud-text-secondary")">
                        @StateTitle(option.State)
                    </MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @StateDescription(option.State)
                    </MudText>
                </div>

                <MudTooltip Text="@L["settings-presence-state-list-option-move-up"]">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward"
                                   Size="Size.Small"
                                   Disabled="@(!movable || index == 0)"
                                   OnClick="@(() => MoveUp(index))" />
                </MudTooltip>

                <MudTooltip Text="@L["settings-presence-state-list-option-move-down"]">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward"
                                   Size="Size.Small"
                                   Disabled="@(!movable || !CanMoveDown(index))"
                                   OnClick="@(() => MoveDown(index))" />
                </MudTooltip>

                <MudTooltip Text="@L["settings-presence-state-list-option-toggle"]">
                    <MudSwitch T="bool"
                               Value="@option.Enabled"
                               ValueChanged="@(v => SetEnabled(index, v))"
                               Color="Color.Primary" />
                </MudTooltip>
            </div>
        }
    </MudStack>
</MudPaper>
