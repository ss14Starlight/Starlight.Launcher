<MudPaper Class="sl-option-card pa-4 mb-2" Outlined="true" Elevation="0">
    <div class="d-flex align-center">
        <div class="sl-option-icon mr-4">
            <MudIcon Icon="@Icon" Size="Size.Small" />
        </div>
        <div class="flex-grow-1">
            <MudText Typo="Typo.body1">@Title</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@Description</MudText>
        </div>
    </div>
    <div class="d-flex gap-2 mt-2">
        <MudNumericField T="int" Value="_days"    ValueChanged="SetDays"    Label="@DaysLabel"    Min="0"            Variant="Variant.Outlined" />
        <MudNumericField T="int" Value="_hours"   ValueChanged="SetHours"   Label="@HoursLabel"   Min="0" Max="23"   Variant="Variant.Outlined" />
        <MudNumericField T="int" Value="_minutes" ValueChanged="SetMinutes" Label="@MinutesLabel" Min="0" Max="59"   Variant="Variant.Outlined" />
        <MudNumericField T="int" Value="_seconds" ValueChanged="SetSeconds" Label="@SecondsLabel" Min="0" Max="59"   Variant="Variant.Outlined" />
    </div>
</MudPaper>
