@using Starlight.Launcher.WebUI.Bridge;
@using Starlight.Launcher.WebUI.Localization;

@inherits LocalizedComponentBase
@inject IDialogService DialogService
@inject IBridge Bridge

@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
        Bridge.ConnectRequested += OnConnectRequested;
    }

    private Task OnConnectRequested(string address, bool needsConfirmation) => InvokeAsync(async () =>
    {
        if (needsConfirmation)
        {
            var confirmed = await DialogService.ShowMessageBoxAsync(
                L["connecting-dialog-confirm-title"],
                L.GetString("connecting-dialog-confirm-unknown", ("address", address)),
                yesText: L["connecting-dialog-confirm-connect"],
                cancelText: L["general-cancel"]);

            if (confirmed != true)
                return;
        }

        var parameters = new DialogParameters<ConnectingDialog>
        {
            { x => x.Address, address },
            { x => x.Title, null }
        };
        var options = new DialogOptions
        {
            BackdropClick = false,
            CloseOnEscapeKey = false,
            CloseButton = false,
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true
        };
        await DialogService.ShowAsync<ConnectingDialog>("Connecting", parameters, options);
    });

    public override void Dispose()
    {
        base.Dispose();
        Bridge.ConnectRequested -= OnConnectRequested;
    }
}
