@using Starlight.Launcher.WebUI.Localization
@inherits LocalizedComponentBase

<MudDialog Class="changelog-dialog">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <div class="sl-dialog-icon">
                <MudIcon Icon="@Icons.Material.Filled.NewReleases" Size="Size.Small" />
            </div>
            <MudText Typo="Typo.h6">@L["changelog-title"]</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        @if (Entries.Count == 0)
        {
            <MudText Color="Color.Secondary" Class="pa-4">@L["changelog-empty"]</MudText>
        }
        else
        {
            <div class="changelog-scroll">
                <MudExpansionPanels Elevation="0" Gutters="false" Class="changelog-panels">
                    @for (var i = 0; i < Entries.Count; i++)
                    {
                        var entry = Entries[i];
                        var isLatest = i == 0;

                        <MudExpansionPanel @key="entry.Version"
                                           Expanded="isLatest"
                                           Class="@($"changelog-panel{(isLatest ? " changelog-panel--latest" : "")}")">
                            <TitleContent>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <span class="@($"changelog-version{(isLatest ? " changelog-version--latest" : "")}")">
                                        v@(entry.Version)
                                    </span>
                                    @if (isLatest)
                                    {
                                        <MudText Typo="Typo.caption" Class="changelog-latest-label">
                                            @L["changelog-latest"]
                                        </MudText>
                                    }
                                </MudStack>
                            </TitleContent>
                            <ChildContent>
                                @if (string.IsNullOrWhiteSpace(entry.Notes))
                                {
                                    <MudText Color="Color.Secondary" Typo="Typo.body2">@L["changelog-empty"]</MudText>
                                }
                                else
                                {
                                    <div class="changelog-markdown">
                                        <MudMarkdown Value="@entry.Notes" />
                                    </div>
                                }
                            </ChildContent>
                        </MudExpansionPanel>
                    }
                </MudExpansionPanels>
            </div>
        }
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Filled" OnClick="Close" Class="cta-btn-primary mr-3 mb-2">
            @L["changelog-close"]
        </MudButton>
    </DialogActions>
</MudDialog>
