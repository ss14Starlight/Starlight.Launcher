@using Starlight.Launcher.WebUI.Localization
@using Starlight.Launcher.WebUI.Models.Data
@inherits LocalizedComponentBase

<MudDialog>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-3">
            @L.GetString("foreign-engine-dialog-body",
                ("version", Warning.EngineVersion),
                ("cdn", Warning.CdnName),
                ("preferred", Warning.PreferredCdnName))
        </MudAlert>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            @L["foreign-engine-dialog-hint"]
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["foreign-engine-dialog-cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Class="cta-btn-warning" OnClick="Confirm">
            @L["foreign-engine-dialog-confirm"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public ForeignEngineWarning Warning { get; set; } = default!;

    private void Confirm() => MudDialog.Close(DialogResult.Ok(true));
    private void Cancel() => MudDialog.Cancel();
}
