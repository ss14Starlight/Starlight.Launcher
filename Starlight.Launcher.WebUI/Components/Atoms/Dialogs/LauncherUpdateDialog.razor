@using Starlight.Launcher.WebUI.Localization

@inherits LocalizedComponentBase

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-3">
            <div class="sl-dialog-icon">
                <MudIcon Icon="@Icons.Material.Filled.SystemUpdateAlt" Size="Size.Small" />
            </div>
            <MudText Typo="Typo.h6">@L["launcher-update-dialog-title"]</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="connect-dialog">
            @switch (_phase)
            {
                case Phase.Failed:
                    <MudAlert Severity="Severity.Error">@_error</MudAlert>
                    break;

                case Phase.Done:
                    <MudAlert Severity="Severity.Success" Dense="true">
                        @L["launcher-update-dialog-done"]
                    </MudAlert>
                    break;

                case Phase.Installing:
                    <div class="d-flex flex-column gap-3 py-2">
                        <MudText Class="connect-meta">@L["launcher-update-dialog-installing"]</MudText>
                        <div class="dl-bar">
                            <div class="dl-bar-fill indeterminate"></div>
                        </div>
                    </div>
                    break;

                default:
                    <div class="d-flex flex-column gap-3 py-2">
                        <div class="d-flex align-end justify-space-between">
                            <MudText Class="connect-meta">
                                @(_phase == Phase.Downloading ? L["launcher-update-dialog-downloading"] : L["launcher-update-dialog-preparing"])
                            </MudText>
                            @if (_hasDeterminateProgress)
                            {
                                <span class="connect-percent">@_percent.ToString("0")%</span>
                            }
                        </div>

                        <div class="dl-bar">
                            @if (_hasDeterminateProgress)
                            {
                                <div class="dl-bar-fill" style="width:@_percentCss%"></div>
                            }
                            else
                            {
                                <div class="dl-bar-fill indeterminate"></div>
                            }
                        </div>

                        @if (_total > 0)
                        {
                            <div class="d-flex align-center justify-space-between connect-meta">
                                <MudText Typo="Typo.caption">@Format(_downloaded) / @Format(_total)</MudText>
                                @if (_haveSpeed && _smoothedBytesPerSec > 1)
                                {
                                    <MudText Typo="Typo.caption">
                                        @Format((long)_smoothedBytesPerSec)/s@(_eta is { } eta ? $" · {L.GetString("launcher-update-dialog-eta", ("eta", eta))}" : "")
                                    </MudText>
                                }
                            </div>
                        }
                    </div>
                    break;
            }
        </div>
    </DialogContent>
    <DialogActions>
        @if (_phase == Phase.Failed)
        {
            <MudButton Variant="Variant.Filled" Class="cta-btn-primary" OnClick="Close">@L["general-close"]</MudButton>
        }
        else if (_phase == Phase.Downloading)
        {
            <MudButton Color="Color.Error" OnClick="Cancel">@L["general-cancel"]</MudButton>
        }
    </DialogActions>
</MudDialog>
