@using Robust.Launcher.Api.Models.ServerStatus
@using Starlight.Launcher.WebUI.Components.Atoms.Journal
@using Starlight.Launcher.WebUI.Localization;

@inherits LocalizedComponentBase

<div class="server-card @(_expanded ? "server-card--expanded" : null)" @onclick="HandleClick" @onblur="HandleBlur" role="button" tabindex="0" aria-expanded="@_expanded">
    <div class="server-card__row" data-reorder-handle="@Reorderable">

        <div class="server-card__primary">
            @if (Reorderable)
            {
                <span class="server-card__grip" title="@L["servers-list-item-drag"]">
                    <MudIcon Icon="@Icons.Material.Rounded.DragIndicator" />
                </span>
            }
            <span class="server-card__chevron">
                <MudIcon Icon="@Icons.Material.Rounded.ChevronRight" />
            </span>
            <div class="server-card__title-block">
                <div class="server-card__title-line">
                    <span class="server-card__name">@(Data.Name ?? Data.Address)</span>
                    @if (_rating > 0)
                    {
                        <span class="server-card__rating" title="@L["server-note-rating-tooltip"]">
                            <MudIcon Icon="@Icons.Material.Rounded.Star" Class="server-card__rating-icon" />@_rating
                        </span>
                    }
                    @if (Data.StatusInfo == ServerStatusInfoCode.Fetching)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true"
                                             Color="Color.Primary" Class="server-card__spinner" />
                    }
                </div>

                @if (_displayTags is { Count: > 0 })
                {
                    <div class="server-card__tags">
                        @foreach (var tag in _displayTags)
                        {
                            <span class="server-card__tag">@tag</span>
                        }
                    </div>
                }
            </div>
        </div>

        @if (_inlineInfo && _infoChips is { Count: > 0 } inlineChips)
        {
            <div class="server-card__inline-info">
                @foreach (var (icon, text, title) in inlineChips)
                {
                    <span class="server-card__info-chip" title="@($"{title}: {text}")">
                        <MudIcon Icon="@icon" Class="server-card__info-icon" /><span class="server-card__info-text">@text</span>
                    </span>
                }
            </div>
        }

        <div class="server-card__meta">
            @if (_pingMs is { } ping)
            {
                <div class="server-card__ping @_pingClass" title="@($"{ping} ms")">
                    <span class="server-card__ping-dot"></span>
                    <span class="server-card__ping-text">@ping ms</span>
                </div>
            }

            @if (_roundStatusText is not null || _roundTime is not null)
            {
                <div class="server-card__round">
                    @if (_roundStatusText is not null)
                    {
                        <span class="server-card__round-status">@_roundStatusText</span>
                    }
                    @if (_roundTime is not null)
                    {
                        <MudIcon Icon="@Icons.Material.Outlined.Schedule" Class="server-card__round-icon" />
                        <span class="server-card__round-time">@_roundTime</span>
                    }
                </div>
            }

            <div class="server-card__players" title="@($"{Data.PlayerCount} / {Data.SoftMaxPlayerCount}")">
                <MudIcon Icon="@Icons.Material.Filled.Person" Class="server-card__players-icon" />
                <span class="server-card__players-text">
                    <strong>@Data.PlayerCount</strong><span class="server-card__players-slash">/</span>@Data.SoftMaxPlayerCount
                </span>
            </div>
        </div>

        <div class="server-card__play" @onclick:stopPropagation="true">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Rounded.PlayArrow"
                       OnClick="Play" Class="server-card__play-btn">
                @L["servers-list-item-play"]
            </MudButton>
        </div>

        <div class="server-card__actions" @onclick:stopPropagation="true">
            <MudTooltip Color="Color.Primary" Text="@L["servers-list-item-favorites"]">
                <MudIconButton Icon="@(IsInFavorites ? Icons.Material.Rounded.Star : Icons.Material.Rounded.StarBorder)"
                               Color="Color.Primary" OnClick="HandleFavorites" />
            </MudTooltip>

            <MudTooltip Color="Color.Primary" Text="@L["servers-list-item-watch"]">
                <MudIconButton Icon="@(_watched ? Icons.Material.Rounded.NotificationsActive : Icons.Material.Rounded.NotificationsNone)"
                               Color="@(_watched ? Color.Primary : Color.Default)" OnClick="OpenWatch" />
            </MudTooltip>

            <MudTooltip Color="Color.Error" Text="@L["servers-list-item-ignore"]">
                <MudIconButton Icon="@Icons.Material.Rounded.VisibilityOff"
                               Class="server-card__ignore-btn"
                               OnClick="HandleIgnore" />
            </MudTooltip>
        </div>
    </div>

    <MudCollapse Expanded="_expanded">
        <div class="server-card__details">
            @if (_infoChips.Count > 0)
            {
                <div class="server-card__info @(_inlineInfo ? "server-card__info--mirrored" : null)">
                    @foreach (var (icon, text, title) in _infoChips)
                    {
                        <span class="server-card__info-chip" title="@title">
                            <MudIcon Icon="@icon" Class="server-card__info-icon" />@text
                        </span>
                    }
                </div>
            }
            <div class="server-card__description">
                @if (!string.IsNullOrWhiteSpace(Data.Description))
                {
                    @Data.Description
                }
                else if (Data.StatusInfo == ServerStatusInfoCode.Error)
                {
                    <span class="server-card__description--error">@L["servers-list-item-details-error"]</span>
                }
                else if (Data.StatusInfo is ServerStatusInfoCode.NotFetched or ServerStatusInfoCode.Fetching)
                {
                    <span class="server-card__description--muted">@L["servers-list-item-details-loading"]</span>
                }
            </div>

            @if (Data.Links is { Length: > 0 })
            {
                <div class="server-card__links">
                    @foreach (var link in Data.Links)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                 Icon="@ParseIcon(link.Icon)"
                                 OnClick="@(() => OnInfoClick(link.Url))">@link.Name</MudChip>
                    }
                </div>
            }

            @if (_expanded)
            {
                <ActivityHeatmap Activity="_activity" />
                <ServerNoteEditor Address="@Data.Address" ServerName="@Data.Name" />
            }
        </div>
    </MudCollapse>
</div>
