@page "/"
@using Starlight.Launcher.WebUI.Components.Atoms.ServerList
@using Starlight.Launcher.WebUI.Localization
@using MudBlazor

@inherits LocalizedComponentBase


<div class="home-content">
    <MudStack Row="true" Spacing="2" Class="pa-2">
        <MudButton StartIcon="@Icons.Material.Filled.Dns"
                   Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="OpenDirectConnect">
            @L["home-menu-dirrect-connect"]
        </MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.Movie"
                   Variant="Variant.Outlined"
                   OnClick="LoadReplay">
            @L["home-menu-load-replay"]
        </MudButton>

        <MudSpacer />

        <MudTooltip Text="@(_reorderLocked ? L["home-menu-reorder-unlock"] : L["home-menu-reorder-lock"])">
            <MudIconButton Icon="@(_reorderLocked ? Icons.Material.Filled.Lock : Icons.Material.Filled.LockOpen)"
                           Variant="Variant.Outlined"
                           Color="@(_reorderLocked ? Color.Primary : Color.Default)"
                           OnClick="ToggleReorderLock" />
        </MudTooltip>

        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                       Variant="Variant.Outlined"
                       OnClick="RefreshServers" />
    </MudStack>

    <div class="server-panel" @ref="_panel">
        @* Not virtualized: reordering needs every item in the DOM. *@
        @foreach (var server in _favoriteServers)
        {
            <div @key="server.Address" data-reorder-key="@server.Address">
                <ServerItem Data="server" Reorderable="@(!_reorderLocked)"
                            IsInFavorites="@(_favoriteServers.Contains(server))"
                            OnFavorites="async x => await HandleFavorite(x)" OnIgnore="HandleIgnore" />
            </div>
        }
    </div>
</div>
