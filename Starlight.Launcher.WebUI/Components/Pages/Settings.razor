@page "/settings"

@using System.Globalization
@using Starlight.Launcher.WebUI.Components.Atoms.Settings
@using Starlight.Launcher.WebUI.Models.Data
@using Starlight.Launcher.WebUI.Models.Logging
@using Starlight.Launcher.WebUI.Models.Settings

@inherits SettingsPageBase


<div class="settings-page">
    <MudTabs Elevation="0" ApplyEffectsToContainer="false" Class="settings-tabs pa-6" TabPanelsClass="settings-tabs-panels">
        <MudTabPanel Text="@L["settings-menu-general-category"]">
            <MudContainer MaxWidth="MaxWidth.Small" Class="pa-0">
                <MudText Typo="Typo.overline" Class="mud-text-secondary">@L["settings-menu-general-category"]</MudText>
                <SelectorListOption Title="@L["settings-menu-language-option"]" Description="@L["settings-menu-language-option-description"]" EmptyOption="true" EmptyOptionName="@L["settings-menu-language-option-system"]" Icon="@Icons.Material.Filled.Language" SelfValueControl="true" SelfValueControlInitialization="async () => await FetchSettings<string?>(s => s.SelectedLanguage)" SelfValueControlAction="x => OnLanguageChanged(x, null, (s, v) => s with { SelectedLanguage = v })" Values="_availableLanguages" DisplayTextSelector="@(x => new CultureInfo(x).EnglishName)" />
                <BoolOption Title="@L["settings-menu-multiple-clients-option"]" Description="@L["settings-menu-multiple-clients-option-description"]" Icon="@Icons.Material.Filled.MultipleStop" SelfValueControl="true" SelfValueControlInitialization="async () => await FetchSettings(s => s.PreventMultipleClients)" SelfValueControlAction="x => OnSettingChanged(x, null, (s, v) => s with { PreventMultipleClients = v })" />
                <FilePathOption Title="@L["settings-menu-data-folder-option"]" Description="@L["settings-menu-data-folder-option-description"]" Icon="@Icons.Material.Filled.FolderOpen" SelfValueControl="true" SelfValueControlInitialization="async () => await FetchSettings(s => s.DirLauncherData)" SelfValueControlAction="x => _ = OnDataFolderChanged(x)" AllowManualInput="false" PickAction="() => _fileDialog.PickFolderAsync()" ShowOpenButton="true" />
                <FilePathOption Title="@L["settings-menu-logs-folder-option"]" Description="@L["settings-menu-logs-folder-option-description"]" Icon="@Icons.Material.Filled.TableChart" SelfValueControl="true" SelfValueControlInitialization="async () => await FetchSettings(s => s.ClientLogDirectory ?? s.DirClientLogsDefault)" SelfValueControlAction="x => OnSettingChanged(x, null, (s, v) => s with { ClientLogDirectory = v })" AllowManualInput="false" PickAction="() => _fileDialog.PickFolderAsync()" ShowOpenButton="true" />
                <EnumOption Title="@L["settings-menu-logs-split-mode-option"]" Description="@L["settings-menu-logs-split-mode-option-description"]" Icon="@Icons.Material.Filled.ModeEdit" SelfValueControl="true" SelfValueControlInitialization="async () => await FetchSettings(s => (int)s.ClientLogSplitMode)" SelfValueControlAction="x => OnSettingChanged(x, null, (s, v) => s with { ClientLogSplitMode = (ClientLogSplitMode)v }, true)" Values="new ClientLogSplitMode()" />
                <BoolOption Title="@L["settings-menu-logs-combine-streams-option"]" Description="@L["settings-menu-logs-combine-streams-option-description"]" Icon="@Icons.Material.Filled.Merge" SelfValueControl="true" SelfValueControlInitialization="async () => await FetchSettings(s => s.ClientLogCombineStreams)" SelfValueControlAction="x => OnSettingChanged(x, null, (s, v) => s with { ClientLogCombineStreams = v })" />
                <NumericFieldOption Title="@L["settings-menu-log-retain-amount-option"]" Description="@L["settings-menu-log-retain-amount-option-description"]" Icon="@Icons.Material.Filled._30fpsSelect" SelfValueControl="true" SelfValueControlInitialization="async () => await FetchSettings(s => s.ClientLogRetainFiles)" SelfValueControlAction="x => OnSettingChanged(x, null, (s, v) => s with { ClientLogRetainFiles = v })" />
                <BoolOption Title="@L["settings-menu-developer-mode-option"]" Description="@L["settings-menu-developer-mode-option-description"]" Icon="@Icons.Material.Filled.DeveloperMode" SelfValueControl="false" Value="_developerMode" ValueChanged="OnDeveloperModeChanged" />
                <BoolOption Title="@L["settings-menu-prereleases-option"]" Description="@L["settings-menu-prereleases-option-description"]" Icon="@Icons.Material.Filled.Science" SelfValueControl="true" SelfValueControlInitialization="async () => await FetchSettings(s => s.ReceivePrereleases)" SelfValueControlAction="x => OnSettingChanged(x, null, (s, v) => s with { ReceivePrereleases = v })" />
                <MudButton StartIcon="@Icons.Material.Filled.BrowserUpdated"
                            Variant="Variant.Filled"
                            FullWidth=true
                            OnClick="CheckUpdate">
                    @L["settings-menu-update-option"]
                </MudButton>
                <MudText Typo="Typo.overline" Class="mud-text-secondary mt-4 d-block">@L["settings-menu-audio-category"]</MudText>
                <SelectorListOption Title="@L["settings-menu-audio-output-mode-option"]" Description="@L["settings-menu-audio-output-mode-option-description"]" EmptyOption="true" EmptyOptionName="@L["settings-menu-audio-output-mode-auto"]" Icon="@Icons.Material.Filled.Speaker" SelfValueControl="true" SelfValueControlInitialization="async () => await FetchSettings<string?>(s => s.AudioOutputMode)" SelfValueControlAction="x => OnSettingChanged(x, null, (s, v) => s with { AudioOutputMode = v })" Values="_audioOutputModes" DisplayTextSelector="AudioOutputModeName" />
                <BoolOption Title="@L["settings-menu-audio-follow-device-option"]" Description="@L["settings-menu-audio-follow-device-option-description"]" Icon="@Icons.Material.Filled.Headphones" SelfValueControl="true" SelfValueControlInitialization="async () => await FetchSettings(s => s.AudioFollowDefaultDevice)" SelfValueControlAction="x => OnSettingChanged(x, null, (s, v) => s with { AudioFollowDefaultDevice = v })" />
                <MudText Typo="Typo.overline" Class="mud-text-secondary mt-4 d-block">@L["settings-menu-journal-category"]</MudText>
                <BoolOption Title="@L["settings-menu-track-activity-option"]" Description="@L["settings-menu-track-activity-option-description"]" Icon="@Icons.Material.Filled.Insights" SelfValueControl="true" SelfValueControlInitialization="async () => await FetchSettings(s => s.TrackServerActivity)" SelfValueControlAction="x => OnSettingChanged(x, null, (s, v) => s with { TrackServerActivity = v })" />
                <BoolOption Title="@L["settings-menu-play-history-option"]" Description="@L["settings-menu-play-history-option-description"]" Icon="@Icons.Material.Filled.History" SelfValueControl="true" SelfValueControlInitialization="async () => await FetchSettings(s => s.RecordPlayHistory)" SelfValueControlAction="x => OnSettingChanged(x, null, (s, v) => s with { RecordPlayHistory = v })" />
                <BoolOption Title="@L["settings-menu-desktop-notifications-option"]" Description="@L["settings-menu-desktop-notifications-option-description"]" Icon="@Icons.Material.Filled.NotificationsActive" SelfValueControl="true" SelfValueControlInitialization="async () => await FetchSettings(s => s.DesktopNotifications)" SelfValueControlAction="x => OnSettingChanged(x, null, (s, v) => s with { DesktopNotifications = v })" />
                <MudText Typo="Typo.overline" Class="mud-text-secondary mt-4 d-block">@L["settings-menu-data-category"]</MudText>
                <ActionOption Title="@L["settings-menu-diagnostics-bundle-option"]" Description="@L["settings-menu-diagnostics-bundle-option-description"]" Icon="@Icons.Material.Filled.Inventory" ButtonText="@L["settings-menu-diagnostics-bundle-button"]" ButtonIcon="@Icons.Material.Filled.FolderZip" Action="OnCreateDiagnosticsBundle" />
            </MudContainer>
        </MudTabPanel>
        <MudTabPanel Text="@L["settings-menu-content-category"]">
            <MudContainer MaxWidth="MaxWidth.Small" Class="pa-0">
                <MudText Typo="Typo.overline" Class="mud-text-secondary">@L["settings-menu-downloads-category"]</MudText>
                <NumericFieldOption Title="@L["settings-menu-download-speed-limit-option"]" Description="@L["settings-menu-download-speed-limit-option-description"]" Icon="@Icons.Material.Filled.Speed" SelfValueControl="true" SelfValueControlInitialization="async () => await FetchSettings(s => s.DownloadSpeedLimitKb)" SelfValueControlAction="x => OnSettingChanged(Math.Max(0, x), null, (s, v) => s with { DownloadSpeedLimitKb = v })" />
                <MudText Typo="Typo.overline" Class="mud-text-secondary mt-4 d-block">@L["settings-menu-storage-category"]</MudText>
                <StorageUsageOption @ref="_storageUsage" Title="@L["settings-storage-option"]" Description="@L["settings-storage-option-description"]" Icon="@Icons.Material.Filled.Storage" />
                <ActionOption Title="@L["settings-menu-verify-content-option"]" Description="@L["settings-menu-verify-content-option-description"]" Icon="@Icons.Material.Filled.FactCheck" ButtonText="@L["settings-menu-verify-content-button"]" ButtonIcon="@Icons.Material.Filled.Build" Action="OnVerifyContent" />
                <ActionOption Title="@L["settings-menu-clear-engines-option"]" Description="@L["settings-menu-clear-engines-option-description"]" Icon="@Icons.Material.Filled.Memory" ButtonText="@L["settings-menu-clear-button"]" ButtonIcon="@Icons.Material.Filled.DeleteSweep" Danger="true" Action="OnClearEngines" />
                <ActionOption Title="@L["settings-menu-clear-content-option"]" Description="@L["settings-menu-clear-content-option-description"]" Icon="@Icons.Material.Filled.Inventory2" ButtonText="@L["settings-menu-clear-button"]" ButtonIcon="@Icons.Material.Filled.DeleteSweep" Danger="true" Action="OnClearContent" />
            </MudContainer>
        </MudTabPanel>
        <MudTabPanel Text="@L["settings-menu-servers-category"]">
            <MudContainer MaxWidth="MaxWidth.Small" Class="pa-0">
                <MudText Typo="Typo.overline" Class="mud-text-secondary">@L["settings-menu-general-category"]</MudText>
                <AlternativeListOption Title="@L["settings-menu-hub-list-option"]" Description="@L["settings-menu-hub-list-option-description"]" AddButtonTooltip="@L["settings-menu-hub-list-option-add-tooltip"]" EmptyValuesString="@L["settings-menu-hub-list-option-empty-values"]" TextFieldLabel="@L["settings-menu-hub-list-option-text-label"]" Icon="@Icons.Material.Filled.Hub" SelfValueControl="true" SelfValueControlInitialization="async () => await FetchSettings<List<(string Url, long Priority)>>(s => [.. s.Hubs.Select(h => (h.HubUri.ToString(), h.Priority))])" SelfValueControlAction="x => OnSettingChanged(x, null, (s, v) => s with { Hubs = ConvertToHubList(v) })" />
                <AlternativeSelectorListOption Title="@L["settings-menu-auth-list-option"]" Description="@L["settings-menu-auth-list-option-description"]" AddButtonTooltip="@L["settings-menu-auth-list-option-add-tooltip"]" EmptyValuesString="@L["settings-menu-auth-list-option-empty-values"]" TextFieldLabel="@L["settings-menu-auth-list-option-text-label"]" Icon="@Icons.Material.Filled.Key" SelfValueControl="true" SelfValueControlInitialization="async () => await FetchSettings<(List<string>, string?)>(s => (s.AuthServerUrls, s.SelectedAuthServer))" SelfValueControlAction="(a, b) => OnSettingChanged((a, b), null, (s, v) => s with { AuthServerUrls = v.a, SelectedAuthServer = v.b })" />
                <BoolOption Title="@L["settings-menu-deauth-onchange-option"]" Description="@L["settings-menu-deauth-onchange-option-description"]" Icon="@Icons.Material.Filled.KeyOff" SelfValueControl="true" SelfValueControlInitialization="async () => await FetchSettings(s => s.DeauthOnChange)" SelfValueControlAction="x => { OnSettingChanged(x, null, (s, v) => s with { DeauthOnChange = !v }); if (Bridge.GetSettings() is { } settings && settings.DeauthOnChange) { Bridge.WriteLogins(new()); Bridge.WriteSettings(settings with { SelectedLoginId = null }); } }" />
                <RobustCdnListOption Title="@L["settings-cdns-option"]"
                                     Description="@L["settings-cdns-option-description"]"
                                     Icon="@Icons.Material.Filled.CloudDownload"
                                     EmptyValuesString="@L["settings-cdns-option-empty"]"
                                     AddButtonTooltip="@L["settings-cdns-option-add"]"
                                     SelfValueControl="true"
                                     SelfValueControlInitialization="@(async () => (await Bridge.GetSettingsAsync()).RobustCdns)"
                                     SelfValueControlAction="x => OnSettingChanged(x, null, (s, v) => s with { RobustCdns = v })" />
            </MudContainer>
        </MudTabPanel>
        <MudTabPanel Text="@L["settings-menu-appearance-category"]">
            <MudContainer MaxWidth="MaxWidth.Small" Class="pa-0">
                <MudText Typo="Typo.overline" Class="mud-text-secondary">@L["settings-menu-general-category"]</MudText>
                <EnumOption Title="@L["settings-menu-theme-option"]" Description="@L["settings-menu-theme-option-description"]" Icon="@Icons.Material.Filled.DarkMode" SelfValueControl="true" SelfValueControlInitialization="async () => await FetchSettings(s => (int)s.Theme)" SelfValueControlAction="x => OnSettingChanged(x, null, (s, v) => s with { Theme = (AppTheme)v }, true)" Values="new AppTheme()" />
                <EnumOption Title="@L["settings-menu-navigation-bar-option"]" Description="@L["settings-menu-navigation-bar-option-description"]" Icon="@Icons.Material.Filled.Menu" SelfValueControl="true" SelfValueControlInitialization="async () => await FetchSettings(s => (int)s.Navigation)" SelfValueControlAction="x => OnSettingChanged(x, null, (s, v) => s with { Navigation = (ElementPosition)v }, true)" Values="new ElementPosition()" />
                <BoolOption Title="@L["settings-menu-animated-background-option"]" Description="@L["settings-menu-animated-background-option-description"]" Icon="@Icons.Material.Filled.AutoAwesome" SelfValueControl="true" SelfValueControlInitialization="async () => await FetchSettings(s => s.AnimatedBackground)" SelfValueControlAction="x => OnSettingChanged(x, null, (s, v) => s with { AnimatedBackground = v }, true)" />
                <MudText Typo="Typo.overline" Class="mud-text-secondary mt-4">@L["settings-menu-server-list-category"]</MudText>
                <BoolOption Title="@L["settings-menu-bottom-search-option"]" Description="@L["settings-menu-bottom-search-option-description"]" Icon="@Icons.Material.Filled.Search" SelfValueControl="true" SelfValueControlInitialization="async () => await FetchSettings(s => s.ServerListToolbarBottomSearch)" SelfValueControlAction="x => OnSettingChanged(x, null, (s, v) => s with { ServerListToolbarBottomSearch = v })" />
                <EnumOption Title="@L["settings-menu-bottom-search-bar-option"]" Description="@L["settings-menu-bottom-search-bar-option-description"]" Icon="@Icons.Material.Filled.YoutubeSearchedFor" SelfValueControl="true" SelfValueControlInitialization="async () => await FetchSettings(s => (int)s.ServerListToolBarSearchPosition)" SelfValueControlAction="x => OnSettingChanged(x, null, (s, v) => s with { ServerListToolBarSearchPosition = (ElementPosition)v })" Values="new ElementPosition()" />
                <EnumOption Title="@L["settings-menu-bottom-tags-bar-option"]" Description="@L["settings-menu-bottom-tags-bar-option-description"]" Icon="@Icons.Material.Filled.VerticalAlignBottom" SelfValueControl="true" SelfValueControlInitialization="async () => await FetchSettings(s => (int)s.ServerListToolBarBottomTagsPosition)" SelfValueControlAction="x => OnSettingChanged(x, null, (s, v) => s with { ServerListToolBarBottomTagsPosition = (ElementPosition)v })" Values="new ElementPosition()" />
                <BoolOption Title="@L["settings-menu-tags-bar-open-option"]" Description="@L["settings-menu-tags-bar-open-option-description"]" Icon="@Icons.Material.Filled.OpenInBrowser" SelfValueControl="true" SelfValueControlInitialization="async () => await FetchSettings(s => s.ServerListToolBarTagsBarOpen)" SelfValueControlAction="x => OnSettingChanged(x, null, (s, v) => s with { ServerListToolBarTagsBarOpen = v })" />
                <MudText Typo="Typo.overline" Class="mud-text-secondary mt-4">@L["settings-menu-tray-category"]</MudText>
                <BoolOption Title="@L["settings-menu-tray-collapse-start-option"]" Description="@L["settings-menu-tray-collapse-start-option-description"]" Icon="@Icons.Material.Filled.PlayDisabled" SelfValueControl="true" SelfValueControlInitialization="async () => await FetchSettings(s => s.CollapseInTrayOnStart)" SelfValueControlAction="x => OnSettingChanged(x, null, (s, v) => s with { CollapseInTrayOnStart = v })" />
                <BoolOption Title="@L["settings-menu-tray-collapse-run-option"]" Description="@L["settings-menu-tray-collapse-run-option-description"]" Icon="@Icons.Material.Filled.VideogameAsset" SelfValueControl="true" SelfValueControlInitialization="async () => await FetchSettings(s => s.CollapseInTrayAfterRun)" SelfValueControlAction="x => OnSettingChanged(x, null, (s, v) => s with { CollapseInTrayAfterRun = v })" />
                <BoolOption Title="@L["settings-menu-tray-uncollapse-end-option"]" Description="@L["settings-menu-tray-uncollapse-end-option-description"]" Icon="@Icons.Material.Filled.VideogameAssetOff" SelfValueControl="true" SelfValueControlInitialization="async () => await FetchSettings(s => s.UnCollapseFromTrayAfterEnd)" SelfValueControlAction="x => OnSettingChanged(x, null, (s, v) => s with { UnCollapseFromTrayAfterEnd = v })" />
                <BoolOption Title="@L["settings-menu-tray-collapse-close-option"]" Description="@L["settings-menu-tray-collapse-close-option-description"]" Icon="@Icons.Material.Filled.Close" SelfValueControl="true" SelfValueControlInitialization="async () => await FetchSettings(s => s.CollapseInTrayOnClose)" SelfValueControlAction="x => OnSettingChanged(x, null, (s, v) => s with { CollapseInTrayOnClose = v })" />
                <BoolOption Title="@L["settings-menu-tray-collapse-minimize-option"]" Description="@L["settings-menu-tray-collapse-minimize-option-description"]" Icon="@Icons.Material.Filled.Minimize" SelfValueControl="true" SelfValueControlInitialization="async () => await FetchSettings(s => s.CollapseInTrayOnMinimize)" SelfValueControlAction="x => OnSettingChanged(x, null, (s, v) => s with { CollapseInTrayOnMinimize = v })" />
            </MudContainer>
        </MudTabPanel>
        <MudTabPanel Text="@L["settings-menu-discord-rpc-category"]">
            <MudContainer MaxWidth="MaxWidth.Small" Class="pa-0">
                <MudText Typo="Typo.overline" Class="mud-text-secondary">@L["settings-menu-general-category"]</MudText>
                <BoolOption Title="@L["settings-menu-discord-presence-option"]" Description="@L["settings-menu-discord-presence-option-description"]" Icon="@Icons.Custom.Brands.Discord" SelfValueControl="true" SelfValueControlInitialization="async () => await FetchSettings(s => !s.HidePresence)" SelfValueControlAction="x => OnSettingChanged(x, null, (s, v) => s with { HidePresence = !v })" />
                <BoolOption Title="@L["settings-menu-discord-presence-buttons-option"]" Description="@L["settings-menu-discord-presence-buttons-option-description"]" Icon="@Icons.Custom.Brands.Discord" SelfValueControl="true" SelfValueControlInitialization="async () => await FetchSettings(s => s.ShowPresenceButtons)" SelfValueControlAction="x => OnSettingChanged(x, null, (s, v) => s with { ShowPresenceButtons = v })" />
                <PresenceStateListOption Icon="@Icons.Material.Filled.Sort"
                                         Title="@L["settings-menu-discord-presence-states-option"]"
                                         Description="@L["settings-menu-discord-presence-states-option-description"]"
                                         SelfValueControlInitialization="async () => await FetchSettings(s => s.PresenceStates)"
                                         SelfValueControlAction="x => OnSettingChanged(x, null, (s, v) => s with { PresenceStates = v })" />
            </MudContainer>
        </MudTabPanel>
        <MudTabPanel Text="@L["settings-menu-ignored-category"]">
            <MudContainer MaxWidth="MaxWidth.Small" Class="pa-0">
                <MudText Typo="Typo.overline" Class="mud-text-secondary">@L["settings-menu-general-category"]</MudText>
                <IgnoredServersOption Title="@L["settings-menu-ignored-servers-option"]" Description="@L["settings-menu-ignored-servers-option-description"]" Icon="@Icons.Material.Filled.VisibilityOff" SelfValueControl="true" SelfValueControlInitialization="async () => await FetchSettings(s => s.IgnoredServers)" SelfValueControlAction="x => OnSettingChanged(x, null, (s, v) => s with { IgnoredServers = v })" />
            </MudContainer>
        </MudTabPanel>
    </MudTabs>

    <div class="settings-reset-button">
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Error"
                   Class="sl-reset-button"
                   StartIcon="@Icons.Material.Filled.SettingsBackupRestore"
                   OnClick="OnResetSettings">
            @L["settings-menu-reset-option"]
        </MudButton>
    </div>
</div>
