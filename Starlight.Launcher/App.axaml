<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Starlight.Launcher.App"
             RequestedThemeVariant="Default">

    <Application.Styles>
        <FluentTheme />

        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="MinWidth" Value="220" />
            <Setter Property="FontFamily" Value="fonts:Inter#Inter, $Default" />
            <Setter Property="FontSize" Value="13" />
            <!-- Room for the drop shadow inside the transparent popup window. -->
            <Setter Property="Margin" Value="10" />
        </Style>
        <Style Selector="MenuFlyoutPresenter /template/ Border#LayoutRoot">
            <Setter Property="BoxShadow" Value="{DynamicResource SlTrayShadow}" />
        </Style>

        <Style Selector="MenuFlyoutPresenter MenuItem">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="MenuFlyoutPresenter MenuItem:disabled">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="MenuFlyoutPresenter Separator">
            <Setter Property="Background" Value="{DynamicResource SlTraySeparator}" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="6,4" />
        </Style>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
            <Thickness x:Key="MenuFlyoutPresenterBorderThemeThickness">1</Thickness>
            <Thickness x:Key="FlyoutBorderThemePadding">6</Thickness>
            <Thickness x:Key="MenuFlyoutScrollerMargin">0</Thickness>
            <Thickness x:Key="MenuFlyoutItemThemePaddingNarrow">10,7,14,7</Thickness>
            <Thickness x:Key="MenuIconPresenterMargin">0,0,12,0</Thickness>
        </ResourceDictionary>
    </Application.Resources>

</Application>
