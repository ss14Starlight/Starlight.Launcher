<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net11.0</TargetFramework>
		<RootNamespace>Starlight.Launcher</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ApplicationIcon>Resources\AppIcon\icon.ico</ApplicationIcon>
	</PropertyGroup>

	<!-- Hide the console window on Windows only (same as before) -->
	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('windows'))">
		<OutputType>WinExe</OutputType>
	</PropertyGroup>
 
	<PropertyGroup>
		<BuildFlavor Condition="'$(FullRelease)' == 'True'">FULL_RELEASE</BuildFlavor>
		<BuildFlavor Condition="'$(FullRelease)' != 'True'">DEVELOPMENT</BuildFlavor>
		<DefineConstants>$(BuildFlavor);$(DefineConstants)</DefineConstants>
	</PropertyGroup>


	<PropertyGroup>
		<AvaloniaVersion>12.0.1</AvaloniaVersion> <!-- bump to whatever's latest on nuget.org -->
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
	</PropertyGroup>

	<ItemGroup>
		<AvaloniaResource Include="Resources\AppIcon\**" />
		<AvaloniaResource Include="Resources\Images\**" />
		<AvaloniaResource Include="Resources\Fonts\**" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\Locale\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Services\ContentManagement\Migrations\*.sql" />
		<EmbeddedResource Include="Services\ContentManagement\Migrations\*.sql" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
		<PackageReference Include="Avalonia.Controls.WebView" Version="$(AvaloniaVersion)" />
		<PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
		<PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" Condition="'$(Configuration)' == 'Debug'" />

		<PackageReference Include="WebView.Avalonia" Version="11.0.0.1" />
		<PackageReference Include="WebView.Avalonia.Desktop" Version="11.0.0.1" />
	</ItemGroup>

	<ItemGroup>
		<!-- Kept, all cross-platform managed libraries -->
		<PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
		<PackageReference Include="Linguini.Bundle" Version="0.11.0" />
		<PackageReference Include="SharpZstd.Interop" Version="1.5.6" />
		<PackageReference Include="Serilog" Version="4.3.1" />
		<PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
		<PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
		<PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />

		<!-- restored only for blazor.web.js, which the in-process Blazor host serves at _framework/ -->
		<PackageReference Include="Microsoft.AspNetCore.App.Internal.Assets" Version="10.0.10" ExcludeAssets="all" PrivateAssets="all" GeneratePathProperty="true" />
		<PackageReference Include="MudBlazor" Version="9.7.0" GeneratePathProperty="true" />

		<!-- Windows-only API (DPAPI)-->
		<PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.8" />
	</ItemGroup>

 
	<ItemGroup>
		<ProjectReference Include="..\Robust.Launcher.Api\Robust.Launcher.Api.csproj" />
		<ProjectReference Include="..\Starlight.Launcher.Analyzer\Starlight.Launcher.Analyzer.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\Starlight.Launcher.WebUI\Starlight.Launcher.WebUI.csproj" />
	</ItemGroup>

	<Target Name="CopyWebUiStaticAssets" AfterTargets="Build">
		<PropertyGroup>
			<_BlazorFrameworkJs>$(PkgMicrosoft_AspNetCore_App_Internal_Assets)\_framework\blazor.web.js</_BlazorFrameworkJs>
			<_MudBlazorFrameworCSS>$(PkgMudBlazor)\staticwebassets\MudBlazor.min.css</_MudBlazorFrameworCSS>
			<_MudBlazorFrameworJs>$(PkgMudBlazor)\staticwebassets\MudBlazor.min.js</_MudBlazorFrameworJs>
		</PropertyGroup>
		<ItemGroup>
			<_WebUiContentAssets Include="$(MSBuildThisFileDirectory)..\Starlight.Launcher.WebUI\wwwroot\**\*" />
			<_WebUiScopedCssBundle Include="$(MSBuildThisFileDirectory)..\Starlight.Launcher.WebUI\obj\$(Configuration)\net11.0\scopedcss\bundle\Starlight.Launcher.WebUI.styles.css" />
		</ItemGroup>
		<Error Condition="!Exists('$(_BlazorFrameworkJs)')"
			   Text="blazor.web.js not found at '$(_BlazorFrameworkJs)' — run a NuGet restore (the Microsoft.AspNetCore.App.Internal.Assets version is pinned in Directory.Packages.props)." />
		<Copy SourceFiles="$(_BlazorFrameworkJs)" DestinationFolder="$(OutputPath)wwwroot\_framework" SkipUnchangedFiles="true" />
		<Copy SourceFiles="$(_MudBlazorFrameworJs)" DestinationFolder="$(OutputPath)wwwroot\_content\MudBlazor" SkipUnchangedFiles="true" />
		<Copy SourceFiles="$(_MudBlazorFrameworCSS)" DestinationFolder="$(OutputPath)wwwroot\_content\MudBlazor" SkipUnchangedFiles="true" />
		<Copy SourceFiles="@(_WebUiContentAssets)" DestinationFolder="$(OutputPath)wwwroot\%(RecursiveDir)" SkipUnchangedFiles="true" />
		<Copy SourceFiles="@(_WebUiScopedCssBundle)" DestinationFolder="$(OutputPath)wwwroot" Condition="Exists('@(_WebUiScopedCssBundle)')" SkipUnchangedFiles="true" />
	</Target>
</Project>