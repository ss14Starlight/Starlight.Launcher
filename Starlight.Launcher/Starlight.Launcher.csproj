<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net11.0</TargetFramework>
		<RootNamespace>Starlight.Launcher</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ApplicationIcon>Resources\AppIcon\icon.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
	</PropertyGroup>

	<!-- Hide the console window on Windows only (same as before) -->
	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('windows'))">
		<OutputType>WinExe</OutputType>
	</PropertyGroup>
 
	<PropertyGroup>
		<BuildFlavor Condition="'$(FullRelease)' == 'True'">FULL_RELEASE</BuildFlavor>
		<BuildFlavor Condition="'$(FullRelease)' != 'True'">DEVELOPMENT</BuildFlavor>
		<DefineConstants>$(BuildFlavor);$(DefineConstants)</DefineConstants>
	</PropertyGroup>


	<PropertyGroup>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Starlight.Launcher.Tests" />
	</ItemGroup>

	<ItemGroup>
		<AvaloniaResource Include="Resources\AppIcon\**" />
		<AvaloniaResource Include="Resources\Images\**" />
		<AvaloniaResource Include="Resources\Fonts\**" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\Locale\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<!-- Without it the launcher refuses to self-update; see LauncherUpdater. -->
		<EmbeddedResource Include="..\PublishFiles\minisign.pub" LogicalName="minisign.pub" Condition="Exists('..\PublishFiles\minisign.pub')" />
	</ItemGroup>

	<Target Name="RequireReleaseSigningKey" BeforeTargets="Build" Condition="'$(FullRelease)' == 'True' And !Exists('..\PublishFiles\minisign.pub')">
		<Error Text="PublishFiles/minisign.pub is missing: a release built without it can't verify its own updates." />
	</Target>

	<ItemGroup>
		<None Remove="Services\ContentManagement\Migrations\*.sql" />
		<EmbeddedResource Include="Services\ContentManagement\Migrations\*.sql" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Diagnostics.NETCore.Client" />
		<!-- Only the EventPipe parser is used; build assets would copy ~10 MB of Windows ETW natives. -->
		<PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" ExcludeAssets="build;buildTransitive" />
		<Reference Include="Avalonia.Controls.WebView">
			<HintPath>packages\Avalonia.Controls.WebView.dll</HintPath>
		</Reference>
		<Reference Include="Avalonia.Controls.WebView.Core">
			<HintPath>packages\Avalonia.Controls.WebView.Core.dll</HintPath>
		</Reference>
		<PackageReference Include="Avalonia" />
		<PackageReference Include="Avalonia.Desktop" />
		<PackageReference Include="Avalonia.Themes.Fluent" />
		<PackageReference Include="Avalonia.Fonts.Inter" />
	</ItemGroup>

	<ItemGroup>
		<!-- Kept, all cross-platform managed libraries -->
		<PackageReference Include="DiscordRichPresence" />
		<PackageReference Include="Linguini.Bundle" />
		<PackageReference Include="Serilog.Extensions.Hosting" />
		<PackageReference Include="Serilog.Formatting.Compact" />
		<PackageReference Include="Serilog.Sinks.Console" />
		<PackageReference Include="Serilog.Sinks.Debug" />
		<PackageReference Include="Serilog.Sinks.File" />

		<!-- restored only for blazor.web.js, which the in-process Blazor host serves at _framework/.
		     Must match the ASP.NET runtime we ship: the JS half of components like Virtualize changes between
		     previews, and a mismatch silently breaks them (e.g. the server list rendering no items). -->
		<PackageReference Include="Microsoft.AspNetCore.App.Internal.Assets" ExcludeAssets="all" PrivateAssets="all" GeneratePathProperty="true" />
		<PackageReference Include="MudBlazor" GeneratePathProperty="true" />
		<PackageReference Include="MudBlazor.Markdown" GeneratePathProperty="true" />

		<!-- Windows-only API (DPAPI)-->
		<PackageReference Include="System.Security.Cryptography.ProtectedData" />
	</ItemGroup>

 
	<ItemGroup>
		<ProjectReference Include="..\Robust.Launcher.Api\Robust.Launcher.Api.csproj" />
		<ProjectReference Include="..\Starlight.Launcher.Analyzer\Starlight.Launcher.Analyzer.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\Starlight.Launcher.WebUI\Starlight.Launcher.WebUI.csproj" />
		<ProjectReference Include="..\Robust.Loader\Robust.Loader.csproj" Condition="'$(_IsPublishing)' != 'true'" ReferenceOutputAssembly="false" Private="false" />
	</ItemGroup>

	<Target Name="CopyWebUiStaticAssets" AfterTargets="Build;Publish">
		<PropertyGroup>
			<_BlazorFrameworkJs>$(PkgMicrosoft_AspNetCore_App_Internal_Assets)/staticwebassets/_framework/blazor.web.js</_BlazorFrameworkJs>
			<!-- older packages (up to preview.4) keep it at the package root -->
			<_BlazorFrameworkJs Condition="!Exists('$(_BlazorFrameworkJs)')">$(PkgMicrosoft_AspNetCore_App_Internal_Assets)/_framework/blazor.web.js</_BlazorFrameworkJs>
			<_MudBlazorFrameworkCSS>$(PkgMudBlazor)/staticwebassets/MudBlazor.min.css</_MudBlazorFrameworkCSS>
			<_MudBlazorFrameworkJs>$(PkgMudBlazor)/staticwebassets/MudBlazor.min.js</_MudBlazorFrameworkJs>
		    <_MudBlazorMarkdownFrameworkJs>$(PkgMudBlazor_Markdown)/staticwebassets/MudBlazor.Markdown.min.js</_MudBlazorMarkdownFrameworkJs>
			<_MudBlazorMarkdownFrameworkCSS>$(PkgMudBlazor_Markdown)/staticwebassets/MudBlazor.Markdown.min.css</_MudBlazorMarkdownFrameworkCSS>
		</PropertyGroup>
		<ItemGroup>
			<_WebUiContentAssets Include="$(MSBuildThisFileDirectory)../Starlight.Launcher.WebUI/wwwroot/**/*" />
			<_WebUiScopedCssBundle Include="$(MSBuildThisFileDirectory)../Starlight.Launcher.WebUI/obj/$(Configuration)/net11.0/scopedcss/bundle/Starlight.Launcher.WebUI.styles.css" />
		</ItemGroup>
		<Error Condition="!Exists('$(_BlazorFrameworkJs)')" Text="blazor.web.js not found at '$(_BlazorFrameworkJs)'." />

		<!-- Blazor -->
		
		<Copy SourceFiles="$(_BlazorFrameworkJs)" DestinationFolder="$(OutputPath)wwwroot/_framework" SkipUnchangedFiles="true" />
		<Copy SourceFiles="$(_BlazorFrameworkJs)" DestinationFolder="$(PublishDir)wwwroot/_framework" Condition="'$(PublishDir)' != ''" SkipUnchangedFiles="true" />

		<!-- MubBlazor -->
		
		<Copy SourceFiles="$(_MudBlazorFrameworkJs)" DestinationFolder="$(OutputPath)wwwroot/_content/MudBlazor" SkipUnchangedFiles="true" />
		<Copy SourceFiles="$(_MudBlazorFrameworkJs)" DestinationFolder="$(PublishDir)wwwroot/_content/MudBlazor" Condition="'$(PublishDir)' != ''" SkipUnchangedFiles="true" />
		<Copy SourceFiles="$(_MudBlazorFrameworkCSS)" DestinationFolder="$(OutputPath)wwwroot/_content/MudBlazor" SkipUnchangedFiles="true" />
		<Copy SourceFiles="$(_MudBlazorFrameworkCSS)" DestinationFolder="$(PublishDir)wwwroot/_content/MudBlazor" Condition="'$(PublishDir)' != ''" SkipUnchangedFiles="true" />

		<!-- Markdown -->
		
		<Copy SourceFiles="$(_MudBlazorMarkdownFrameworkJs)" DestinationFolder="$(OutputPath)wwwroot/_content/MudBlazor.Markdown" SkipUnchangedFiles="true" />
		<Copy SourceFiles="$(_MudBlazorMarkdownFrameworkJs)" DestinationFolder="$(PublishDir)wwwroot/_content/MudBlazor.Markdown" Condition="'$(PublishDir)' != ''" SkipUnchangedFiles="true" />
		<Copy SourceFiles="$(_MudBlazorMarkdownFrameworkCSS)" DestinationFolder="$(OutputPath)wwwroot/_content/MudBlazor.Markdown" SkipUnchangedFiles="true" />
		<Copy SourceFiles="$(_MudBlazorMarkdownFrameworkCSS)" DestinationFolder="$(PublishDir)wwwroot/_content/MudBlazor.Markdown" Condition="'$(PublishDir)' != ''" SkipUnchangedFiles="true" />

		<!-- wwwroot -->
		
		<Copy SourceFiles="@(_WebUiContentAssets)" DestinationFolder="$(OutputPath)wwwroot/%(RecursiveDir)" SkipUnchangedFiles="true" />
		<Copy SourceFiles="@(_WebUiContentAssets)" DestinationFolder="$(PublishDir)wwwroot/%(RecursiveDir)" Condition="'$(PublishDir)' != ''" SkipUnchangedFiles="true" />

		<!-- scoped css -->
		
		<Copy SourceFiles="@(_WebUiScopedCssBundle)" DestinationFolder="$(OutputPath)wwwroot" Condition="Exists('@(_WebUiScopedCssBundle)')" SkipUnchangedFiles="true" />
		<Copy SourceFiles="@(_WebUiScopedCssBundle)" DestinationFolder="$(PublishDir)wwwroot" Condition="'$(PublishDir)' != ''" SkipUnchangedFiles="true" />
	</Target>
</Project>