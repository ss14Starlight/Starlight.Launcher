<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net11.0</TargetFramework>
		<RootNamespace>Starlight.Launcher</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ApplicationIcon>Resources\AppIcon\icon.ico</ApplicationIcon>
	</PropertyGroup>
 
	<!-- Hide the console window on Windows only (same as before) -->
	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('windows'))">
		<OutputType>WinExe</OutputType>
	</PropertyGroup>
 
	<PropertyGroup>
		<BuildFlavor Condition="'$(FullRelease)' == 'True'">FULL_RELEASE</BuildFlavor>
		<BuildFlavor Condition="'$(FullRelease)' != 'True'">DEVELOPMENT</BuildFlavor>
		<DefineConstants>$(BuildFlavor);$(DefineConstants)</DefineConstants>
	</PropertyGroup>


	<PropertyGroup>
		<AvaloniaVersion>12.0.1</AvaloniaVersion> <!-- bump to whatever's latest on nuget.org -->
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
	</PropertyGroup>

	<ItemGroup>
		<AvaloniaResource Include="Resources\AppIcon\**" />
		<AvaloniaResource Include="Resources\Images\**" />
		<AvaloniaResource Include="Resources\Fonts\**" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Services\ContentManagement\Migrations\*.sql" />
		<EmbeddedResource Include="Services\ContentManagement\Migrations\*.sql" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
		<PackageReference Include="Avalonia.Controls.WebView" Version="$(AvaloniaVersion)" />
		<PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
		<PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" Condition="'$(Configuration)' == 'Debug'" />

		<PackageReference Include="WebView.Avalonia" Version="11.0.0.1" />
		<PackageReference Include="WebView.Avalonia.Desktop" Version="11.0.0.1" />
	</ItemGroup>

	<ItemGroup>
		<!-- Kept, all cross-platform managed libraries -->
		<PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
		<PackageReference Include="Linguini.Bundle" Version="0.11.0" />
		<PackageReference Include="SharpZstd.Interop" Version="1.5.6" />
		<PackageReference Include="Serilog" Version="4.3.1" />
		<PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
		<PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
		<PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />

		<!-- Windows-only API (DPAPI)-->
		<PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.8" />
	</ItemGroup>

 
	<ItemGroup>
		<ProjectReference Include="..\Robust.Launcher.Api\Robust.Launcher.Api.csproj" />
		<ProjectReference Include="..\Starlight.Launcher.Analyzer\Starlight.Launcher.Analyzer.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\Starlight.Launcher.WebUI\Starlight.Launcher.WebUI.csproj" />
	</ItemGroup>
</Project>
